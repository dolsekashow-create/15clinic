rules_version = '2';

// ─────────────────────────────────────────────────────────────
// DEFENCE IN DEPTH — NOT the primary authorisation layer.
//
// All dashboard and mobile traffic goes through the server (Admin SDK), which
// bypasses these rules entirely. Real authorisation lives in packages/auth and
// packages/data. These rules exist so that a leaked client config cannot be
// used to read the database directly.
//
// Posture: deny everything by default; allow only the narrow, read-only cases
// the client SDK genuinely needs.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function sameOrg(orgId) {
      return isSignedIn() && request.auth.token.organizationId == orgId;
    }

    // Customers may read their own record from the mobile app.
    match /customers/{customerId} {
      allow read: if isSignedIn()
        && resource.data.mobileAuthUid == request.auth.uid;
      allow write: if false; // writes go through the API
    }

    // A customer may read their own appointments.
    match /appointments/{appointmentId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/customers/$(resource.data.customerId))
        && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.mobileAuthUid == request.auth.uid;
      allow write: if false;
    }

    // Public-ish catalogue data, still scoped to the organisation.
    match /branches/{branchId} {
      allow read: if sameOrg(resource.data.organizationId) && resource.data.isDeleted == false;
      allow write: if false;
    }
    match /services/{serviceId} {
      allow read: if sameOrg(resource.data.organizationId) && resource.data.isDeleted == false;
      allow write: if false;
    }
    match /doctors/{doctorId} {
      allow read: if sameOrg(resource.data.organizationId) && resource.data.isDeleted == false;
      allow write: if false;
    }

    // Notifications addressed to the signed-in user.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUserId == request.auth.uid;
      allow write: if false;
    }

    // Audit log is append-only and never client-readable.
    match /audit_logs/{logId} {
      allow read, create, update, delete: if false;
    }

    // Accounting is server-only, without exception.
    match /accounts/{doc}          { allow read, write: if false; }
    match /journal_entries/{doc}   { allow read, write: if false; }
    match /invoices/{doc}          { allow read, write: if false; }
    match /payments/{doc}          { allow read, write: if false; }
    match /cash_sessions/{doc}     { allow read, write: if false; }
    match /fiscal_periods/{doc}    { allow read, write: if false; }
    match /tax_rates/{doc}         { allow read, write: if false; }
    match /visits/{doc}            { allow read, write: if false; }
    match /queue_counters/{doc}    { allow read, write: if false; }
    match /sequences/{doc}         { allow read, write: if false; }

    // Everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
